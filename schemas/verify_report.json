{
  "$defs": {
    "WorkloadResult": {
      "additionalProperties": false,
      "description": "Performance measurement result for a single workload size n.",
      "properties": {
        "n": {
          "exclusiveMinimum": 0,
          "title": "N",
          "type": "integer"
        },
        "original_ms_median": {
          "minimum": 0.0,
          "title": "Original Ms Median",
          "type": "number"
        },
        "candidate_ms_median": {
          "minimum": 0.0,
          "title": "Candidate Ms Median",
          "type": "number"
        },
        "runs": {
          "exclusiveMinimum": 0,
          "title": "Runs",
          "type": "integer"
        }
      },
      "required": [
        "n",
        "original_ms_median",
        "candidate_ms_median",
        "runs"
      ],
      "title": "WorkloadResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Verification and benchmarking report for a proposed candidate.",
  "properties": {
    "candidate_id": {
      "title": "Candidate Id",
      "type": "string"
    },
    "equivalent": {
      "title": "Equivalent",
      "type": "boolean"
    },
    "rejected_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rejected Reason"
    },
    "workloads": {
      "items": {
        "$ref": "#/$defs/WorkloadResult"
      },
      "title": "Workloads",
      "type": "array"
    },
    "speedup_at_max_n": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Speedup At Max N"
    },
    "crossover_n": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Crossover N"
    }
  },
  "required": [
    "candidate_id",
    "equivalent",
    "workloads"
  ],
  "title": "VerifyReport",
  "type": "object"
}
